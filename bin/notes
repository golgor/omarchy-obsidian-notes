#!/usr/bin/env bash
# Obsidian quick-notes: capture, list, and copy notes.
#
#   notes capture [text] Prompt/save a timestamped note (text argument or stdin).
#   notes list           Print "path<TAB>title<TAB>body" per note, newest first.
#   notes copy <path>     Copy a note's full text to the clipboard.
#   notes delete <path>   Move a note to the system trash (gio trash).
set -euo pipefail

# Vault location comes from the NOTES_DIR environment variable (set it in
# ~/.bashrc). Falls back to a generic default so this repo carries no personal path.
NOTES_DIR="${NOTES_DIR:-$HOME/Documents/Notes}"
BODY_LEN=100

capture() {
  mkdir -p "$NOTES_DIR"
  local text="${1:-}"
  if [[ -z "$text" && ! -t 0 ]]; then
    text="$(cat -)"
  fi
  [[ -z "${text//[[:space:]]/}" ]] && exit 0   # empty / whitespace-only: write nothing
  printf '%s\n' "$text" > "$NOTES_DIR/$(date +%Y-%m-%d-%H%M%S).md"
}

# Turn a timestamp basename (2026-08-20-100149) into a heading (2026-08-20 10:01:49).
# Anything not matching that shape is shown as-is (e.g. notes made inside Obsidian).
fmt_title() {
  local b="$1"
  if [[ "$b" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})-([0-9]{2})([0-9]{2})([0-9]{2})$ ]]; then
    printf '%s %s:%s:%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
  else
    printf '%s' "$b"
  fi
}

# ponytail: filenames are timestamp-only (no spaces/newlines), so ls|read is safe here.
list() {
  [[ -d "$NOTES_DIR" ]] || exit 0
  local f first_line title body
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    first_line="$(grep -v '^[[:space:]]*$' "$f" 2>/dev/null | head -n1 || true)"
    if [[ "$first_line" =~ ^#+[[:space:]]+(.+) ]]; then
      title="${BASH_REMATCH[1]}"
      body="$(sed '0,/^#\{1,6\}[[:space:]]/d' "$f" | grep -v '^[[:space:]]*$' | head -n 3 | awk '{printf "%s\\n", $0}' | sed 's/\\n$//')"
    else
      title="$(fmt_title "$(basename -- "$f" .md)")"
      body="$(head -n 3 "$f" | awk '{printf "%s\\n", $0}' | sed 's/\\n$//')"
    fi
    if [[ ${#body} -gt $BODY_LEN ]]; then
      body="${body:0:$BODY_LEN}..."
    fi
    [[ -n "$body" ]] || body="(empty note)"
    printf '%s\t%s\t%s\n' "$f" "$title" "$body"
  done < <(ls -1t "$NOTES_DIR"/*.md 2>/dev/null)
}

copy() {
  local path="${1:?path required}"
  [[ -f "$path" ]] || { echo "no such note: $path" >&2; exit 1; }
  wl-copy < "$path"
}

# ponytail: thin wrapper over gio trash (recoverable); no test needed.
trash_note() {
  local path="${1:?path required}"
  [[ -f "$path" ]] || { echo "no such note: $path" >&2; exit 1; }
  gio trash "$path"
}

case "${1:-}" in
  capture) shift; capture "${1:-}" ;;
  list)    list ;;
  copy)    shift; copy "${1:-}" ;;
  delete)  shift; trash_note "${1:-}" ;;
  *) echo "usage: notes {capture [text]|list|copy <path>|delete <path>}" >&2; exit 2 ;;
esac
